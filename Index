<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<title>ATGS | NHL 2026–27</title>
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🏒</text></svg>">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600&family=Barlow+Condensed:wght@500;600;700&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
:root{
  --rink:#13233d; --rink-2:#1b3150; --ice:#eef3f8; --card:#ffffff; --line:#d9e1ea; --line-2:#edf1f6;
  --ink:#0f1b2d; --mute:#5b6b80; --faint:#8a98ab;
  --win:#15803d; --win-bg:#eaf6ee; --loss:#c62828; --loss-bg:#fdecec;
  --odds:#b45309; --accent:#1d6fd8; --accent-bg:#e8f1fc;
  --num:'Barlow Condensed',system-ui,sans-serif; --txt:'Barlow',system-ui,-apple-system,sans-serif;
}
html,body{height:100%;overflow:hidden}
body{font-family:var(--txt);background:var(--ice);color:var(--ink);display:flex;flex-direction:column;font-size:15px;
  padding-top:env(safe-area-inset-top,0px)}
.num{font-family:var(--num);font-variant-numeric:tabular-nums}
.pos{color:var(--win)} .neg{color:var(--loss)} .zero{color:var(--faint)}
button{font:inherit;color:inherit}
:focus-visible{outline:2px solid var(--accent);outline-offset:2px}

/* ── Top bar ── */
.topbar{flex-shrink:0;background:var(--rink);color:#fff;display:flex;align-items:center;gap:24px;padding:14px 28px}
.brand{display:flex;align-items:center;gap:14px;margin-right:auto;min-width:0}
.brand b{font-family:var(--num);font-weight:700;font-size:1.9rem;letter-spacing:.5px;line-height:1}
.brand .season{color:rgba(255,255,255,.45);font-size:.85rem;white-space:nowrap}
.devig{display:flex;align-items:center;gap:5px;white-space:nowrap}
.dv-lbl{font-size:.76rem;color:rgba(255,255,255,.6);margin-right:3px}
.dv-chip{font-family:var(--num);font-weight:600;font-size:.86rem;letter-spacing:.4px;color:#fff;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.2);border-radius:6px;padding:2px 8px;line-height:1.3}
.chips{display:flex;gap:28px}
.chip{display:flex;flex-direction:column;align-items:flex-end}
.chip small{font-size:.72rem;color:rgba(255,255,255,.55)}
.chip strong{font-family:var(--num);font-weight:600;font-size:1.6rem;line-height:1.1;white-space:nowrap}
.chips{flex-shrink:0}
.chip .pos{color:#5ee08a} .chip .neg{color:#ff8a8a} .chip .zero{color:rgba(255,255,255,.6)}
.date-pill{font-size:.82rem;color:rgba(255,255,255,.8);border:1px solid rgba(255,255,255,.2);border-radius:999px;padding:6px 14px;white-space:nowrap}

/* ── Tabs + ticker ── */
.tabs{flex-shrink:0;background:var(--rink);display:flex;gap:4px;padding:0 20px;border-top:1px solid rgba(255,255,255,.08)}
.tab{background:none;border:0;cursor:pointer;color:rgba(255,255,255,.55);font-weight:600;padding:10px 14px;border-bottom:3px solid transparent}
.tab[aria-selected="true"]{color:#fff;border-bottom-color:#7fb5ff}
.ticker{flex-shrink:0;height:28px;overflow:hidden;background:var(--rink-2);display:flex;align-items:center}
.ticker-track{display:inline-flex;gap:40px;white-space:nowrap;padding-left:100%;animation:scroll 70s linear infinite;font-size:.78rem;color:rgba(255,255,255,.55)}
.ticker-track em{font-style:normal;color:#fff;font-weight:600}
@keyframes scroll{to{transform:translateX(-50%)}}
@media (prefers-reduced-motion:reduce){.ticker-track{animation:none;padding-left:20px}}

/* ── Pages ── */
main{flex:1;min-height:0;display:flex;flex-direction:column}
.page{display:none;flex:1;min-height:0}
.page.on{display:flex}

/* ── Daily ── */
.daily{flex:1;display:grid;grid-template-columns:minmax(0,1.45fr) minmax(0,1fr) minmax(0,.9fr);gap:1px;background:var(--line);min-height:0}
.pane{background:var(--card);display:flex;flex-direction:column;min-height:0}
.pane-head{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:14px 18px;border-bottom:1px solid var(--line)}
.pane-head h2{font-family:var(--num);font-weight:700;font-size:1.35rem;letter-spacing:.2px}
.count{font-size:.8rem;color:var(--mute);background:var(--ice);border-radius:999px;padding:3px 10px}
.count:empty{display:none}
.scroll{flex:1;overflow-y:auto;-webkit-overflow-scrolling:touch}
.subtabs{display:none}

.pane{container-type:inline-size}
.slate{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));border-bottom:1px solid var(--line);background:#f7f9fc}
.slate div{padding:10px 18px;border-right:1px solid var(--line-2);min-width:0}
.slate div:last-child{border-right:0}
.slate strong{display:block;font-family:var(--num);font-weight:700;font-size:1.45rem;line-height:1.1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.slate small{font-size:.72rem;color:var(--mute);white-space:nowrap}
.slate .sub{font-family:var(--txt);font-size:.72rem;font-weight:500;color:var(--mute);margin-left:4px}

.prow{display:grid;grid-template-columns:minmax(0,1fr) 96px 64px 52px 112px;gap:12px;align-items:center;padding:11px 18px;border-bottom:1px solid var(--line-2)}
.phead{font-size:.72rem;color:var(--mute);padding-top:8px;padding-bottom:8px;border-bottom:1px solid var(--line);position:sticky;top:0;background:var(--card);z-index:1}
.phead .r,.prow .r{text-align:right}
.prow.top{box-shadow:inset 3px 0 0 var(--win)}
.player{font-weight:600;display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.pmeta{font-size:.76rem;color:var(--mute);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;display:block}
.pmeta .mbook{display:none}
.book{font-size:.8rem;font-weight:500;color:var(--ink);background:var(--ice);border:1px solid var(--line);border-radius:6px;padding:2px 8px 2px 6px;white-space:nowrap}
.bdot{display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:6px;vertical-align:1px;flex-shrink:0}
.res.W{background:rgba(21,128,61,.055)} .res.L{background:rgba(198,40,40,.05)}
.cal{padding:16px 18px 12px}
.cal svg{width:100%;height:auto;display:block;max-width:980px}
.cal svg rect{shape-rendering:crispEdges}
.cal-foot{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin-top:10px;font-size:.8rem;color:var(--mute)}
.cal-legend{display:flex;align-items:center;gap:3px}
.cal-legend i{width:12px;height:12px;border-radius:2px;display:inline-block}
.cal-legend span{margin:0 6px}
.odds{font-family:var(--num);font-weight:600;font-size:1.15rem;color:var(--odds)}
.fv{font-family:var(--num);color:var(--faint);font-size:1rem}
.evc{display:flex;align-items:center;justify-content:flex-end;gap:8px}
.ev{font-family:var(--num);font-weight:700;color:var(--win);font-size:1.1rem;min-width:40px;text-align:right}
.ev.neg{color:var(--loss)}
.evbar{width:52px;height:6px;border-radius:3px;background:var(--win-bg);overflow:hidden;flex-shrink:0}
.evbar i{display:block;height:100%;background:var(--win);border-radius:3px}
.prow.cashed>*{opacity:.45} .prow.cashed .player{text-decoration:line-through}
.prow.pending>*{opacity:.6} .ptag{display:inline-block;font-size:.66rem;font-weight:600;letter-spacing:.4px;text-transform:uppercase;color:var(--odds);background:#fdf3e1;border:1px solid #f3dcae;border-radius:4px;padding:0 5px;margin-right:6px;vertical-align:1px}
.tag{font-size:.7rem;font-weight:500;color:var(--mute);background:var(--ice);border-radius:4px;padding:1px 6px;margin-left:6px}

@container (max-width:560px){
  .prow{grid-template-columns:minmax(0,1fr) 60px 92px;gap:10px;padding:10px 14px}
  .c-book,.c-fv{display:none}
  .pmeta .mbook{display:inline}
  .evbar{width:36px}
  .slate div{padding:9px 12px}
  .slate strong{font-size:1.2rem}
  .slate .sub{display:none}
}

.res-sum{display:grid;grid-template-columns:repeat(4,1fr);padding:12px 18px;border-bottom:1px solid var(--line);gap:8px;background:#f7f9fc}
.res-sum div strong{display:block;font-family:var(--num);font-size:1.5rem;font-weight:700;line-height:1}
.res-sum div small{font-size:.72rem;color:var(--mute)}
.res-grid{display:grid;grid-template-columns:1fr}
@container (min-width:600px){ .res-grid{grid-template-columns:1fr 1fr} .res-grid .res:nth-child(odd){border-right:1px solid var(--line-2)} }
.res{display:grid;grid-template-columns:4px minmax(0,1fr) auto auto;align-items:center;border-bottom:1px solid var(--line-2)}
.res i{align-self:stretch;background:var(--faint)} .res.W i{background:var(--win)} .res.L i{background:var(--loss)}
.res .who{padding:9px 12px;min-width:0} .res .who b{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.res .who small{display:block;font-size:.75rem;color:var(--mute)}
.res .o{padding:0 8px} .res .p{font-family:var(--num);font-weight:700;font-size:1.1rem;padding:0 14px 0 4px;min-width:64px;text-align:right}
.res.V .who b{text-decoration:line-through;opacity:.5}

.parlay{margin:12px 14px;border:1px solid var(--line);border-radius:10px;overflow:hidden}
.parlay header{display:flex;justify-content:space-between;align-items:center;padding:8px 12px;background:var(--ice)}
.parlay header .odds{font-size:1.2rem}
.parlay header small{font-size:.75rem;color:var(--mute)}
.parlay .legs{counter-reset:leg}
.leg::before{counter-increment:leg;content:counter(leg);font-family:var(--num);color:var(--faint);width:14px;flex-shrink:0}
.leg{padding:8px 12px;border-top:1px solid var(--line-2);display:flex;align-items:baseline;gap:10px}
.leg .lw{flex:1;min-width:0;display:flex;flex-direction:column}
.leg small{color:var(--mute);font-size:.78rem}
.leg .lo{font-size:1.05rem}
.pstake{display:flex;justify-content:space-between;gap:10px;padding:7px 12px;font-size:.8rem;color:var(--mute);border-top:1px solid var(--line-2)}
.pstake b{font-family:var(--num);font-size:1.05rem;color:var(--ink);margin-left:4px}
.parlay header .tag{vertical-align:3px}

.empty{padding:48px 24px;text-align:center;color:var(--mute);font-size:.9rem;line-height:1.5}
.empty strong{display:block;color:var(--ink);font-family:var(--num);font-size:1.2rem;font-weight:600;margin-bottom:4px}

/* ── Summary ── */
.summary{flex:1;overflow-y:auto;-webkit-overflow-scrolling:touch}
.wrap{max-width:1180px;margin:0 auto;padding:20px 24px 40px}
.seg{display:inline-flex;background:#dde6f0;border-radius:10px;padding:3px;margin-bottom:18px}
.seg button{border:0;background:none;cursor:pointer;padding:8px 16px;border-radius:8px;font-weight:600;color:var(--mute)}
.seg button[aria-selected="true"]{background:var(--card);color:var(--ink);box-shadow:0 1px 2px rgba(15,27,45,.12)}

.hero{background:var(--rink);color:#fff;border-radius:16px;padding:24px 28px 8px;margin-bottom:16px}
.hero-top{display:flex;justify-content:space-between;align-items:flex-end;gap:24px;flex-wrap:wrap}
.hero h1{font-family:var(--num);font-weight:600;font-size:1.05rem;color:rgba(255,255,255,.7)}
.hero .span{font-size:.82rem;color:rgba(255,255,255,.45);margin-top:2px}
.big{font-family:var(--num);font-weight:700;font-size:4.6rem;line-height:.95;margin-top:10px;font-variant-numeric:tabular-nums}
.big.pos{color:#5ee08a} .big.neg{color:#ff8a8a} .big.zero{color:#fff}
.big-lbl{font-size:.82rem;color:rgba(255,255,255,.55)}
.hstats{display:grid;grid-template-columns:repeat(3,auto);gap:12px 36px}
.hstats div small{display:block;font-size:.74rem;color:rgba(255,255,255,.5)}
.hstats div strong{font-family:var(--num);font-weight:600;font-size:1.45rem;white-space:nowrap}
.chart{margin-top:16px;position:relative}
.chart svg{width:100%;height:auto;display:block}
.chart-cap{font-size:.74rem;color:rgba(255,255,255,.45);margin:14px 0 -6px}
.chart .none{height:150px;display:flex;align-items:center;justify-content:center;color:rgba(255,255,255,.45);font-size:.9rem;border-top:1px dashed rgba(255,255,255,.18)}

.grid{display:grid;gap:12px}
.g6{grid-template-columns:repeat(6,1fr)} .g2{grid-template-columns:1fr 1fr} .g3{grid-template-columns:repeat(3,1fr)}
.card{background:var(--card);border:1px solid var(--line);border-radius:12px}
.tile{padding:14px 16px}
.tile small{font-size:.76rem;color:var(--mute)}
.tile strong{display:block;font-family:var(--num);font-weight:700;font-size:1.6rem;line-height:1.1;margin-top:2px}
.tile span{font-size:.78rem;color:var(--faint)}
h3.sec{font-family:var(--num);font-weight:700;font-size:1.3rem;margin:26px 0 10px}

table.t{width:100%;border-collapse:collapse}
table.t th{font-size:.74rem;font-weight:500;color:var(--mute);text-align:right;padding:10px 16px;border-bottom:1px solid var(--line)}
table.t th:first-child,table.t td:first-child{text-align:left}
table.t td{padding:10px 16px;border-bottom:1px solid var(--line-2);text-align:right;font-family:var(--num);font-size:1.05rem}
table.t td:first-child{font-family:var(--txt);font-size:.95rem;font-weight:600}
table.t tr:last-child td{border-bottom:0}
table.t td.meta{font-family:var(--txt);font-size:.85rem;color:var(--mute);font-weight:400}
.bar{display:inline-block;height:6px;border-radius:3px;vertical-align:middle;margin-right:8px}

.month header{display:flex;justify-content:space-between;align-items:baseline;padding:12px 16px;border-bottom:1px solid var(--line)}
.month header b{font-family:var(--num);font-weight:700;font-size:1.15rem}
.month header strong{font-family:var(--num);font-weight:700;font-size:1.3rem}
.month .rec{font-size:.78rem;color:var(--mute);padding:8px 16px 2px}
.month .row{display:flex;justify-content:space-between;padding:4px 16px;font-size:.9rem}
.month .row span:last-child{font-family:var(--num);font-weight:600;font-size:1rem}
.month footer{display:flex;justify-content:space-between;padding:8px 16px;margin-top:6px;border-top:1px solid var(--line);font-size:.82rem;color:var(--mute)}
.month footer b{font-family:var(--num);font-size:1rem}

.lb header{padding:12px 16px;border-bottom:1px solid var(--line);font-family:var(--num);font-weight:700;font-size:1.15rem}
.lb .row{display:grid;grid-template-columns:22px 1fr auto 72px;gap:10px;align-items:center;padding:10px 16px;border-bottom:1px solid var(--line-2)}
.lb .row:last-child{border-bottom:0}
.lb .rk{font-family:var(--num);color:var(--faint)} .lb .rec{font-size:.8rem;color:var(--mute)}
.lb .pl{font-family:var(--num);font-weight:700;font-size:1.1rem;text-align:right}

.notes{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.note{padding:16px 18px;border-left:4px solid var(--accent)}
.note.w{border-left-color:var(--win)} .note.l{border-left-color:var(--loss)} .note.o{border-left-color:var(--odds)}
.note b{display:block;font-size:1rem;margin-bottom:4px}
.note p{font-size:.88rem;color:var(--mute);line-height:1.5}
.hint{color:var(--mute);font-size:.9rem;line-height:1.5;padding:18px}

.foot{flex-shrink:0;text-align:center;padding:8px 16px;font-size:.7rem;color:var(--faint);border-top:1px solid var(--line);background:var(--card)}
.bottom-nav{display:none}
.ph-right{display:flex;align-items:center;gap:8px}
.collapse-btn{width:30px;height:30px;display:grid;place-items:center;border:1px solid var(--line);background:var(--card);border-radius:8px;color:var(--mute);cursor:pointer;flex-shrink:0}
.collapse-btn:hover{color:var(--ink);background:var(--ice)}
.collapse-btn svg{transition:transform .2s ease}
.daily.parlays-collapsed .collapse-btn svg{transform:rotate(180deg)}
@media (min-width:641px){ .daily.parlays-collapsed #parlayList{display:none} .daily.parlays-collapsed #parlayHead{cursor:pointer;border-bottom:0} }
/* Desktop: collapsed parlays become a slim rail on the right */
@media (min-width:1101px){
  .daily{transition:grid-template-columns .2s ease}
  .daily.parlays-collapsed{grid-template-columns:minmax(0,1.45fr) minmax(0,1fr) 52px}
  .daily.parlays-collapsed #parlayHead{flex-direction:column-reverse;justify-content:flex-end;align-items:center;gap:14px;padding:12px 0;height:100%}
  .daily.parlays-collapsed #parlayHead .ph-right{flex-direction:column}
  .daily.parlays-collapsed #parlayHead h2,.daily.parlays-collapsed #parlayCount{writing-mode:vertical-rl;transform:rotate(180deg)}
  .daily.parlays-collapsed #parlayHead h2{font-size:1.1rem}
  .daily.parlays-collapsed #parlayCount{padding:10px 3px}
}

/* ── Responsive ── */
@media (max-width:1100px){ .g6{grid-template-columns:repeat(3,1fr)} .g3{grid-template-columns:1fr 1fr} }
@media (min-width:641px) and (max-width:1100px){
  .daily{grid-template-columns:minmax(0,1.2fr) minmax(0,1fr);grid-template-rows:minmax(0,1.15fr) minmax(0,1fr)}
  #paneToday{grid-row:1 / span 2}
  .daily.parlays-collapsed{grid-template-rows:minmax(0,1fr) auto}
  .collapse-btn svg{transform:rotate(90deg)}
  .daily.parlays-collapsed .collapse-btn svg{transform:rotate(-90deg)}
  .topbar{padding:12px 20px;gap:18px}
  .brand .season{display:none}
}
@media (min-width:641px) and (max-width:1000px){
  .brand{flex-direction:column;align-items:flex-start;gap:5px}
  .brand b{font-size:1.6rem}
  .dv-lbl{font-size:.68rem} .dv-chip{font-size:.74rem;padding:1px 6px}
}
@media (min-width:641px) and (max-width:820px){
  .chips{gap:18px} .chip strong{font-size:1.35rem}
  .date-pill{display:none}
  .chips .chip:nth-child(4){display:none}
}
@media (min-width:821px) and (max-width:1000px){
  .date-pill{display:none}
}
@media (max-width:640px){
  body{font-size:14px}
  .topbar{padding:10px 14px;gap:12px}
  .brand .season,.date-pill,.tabs{display:none}
  .brand{flex-direction:column;align-items:flex-start;gap:4px}
  .brand b{font-size:1.45rem}
  .devig{gap:3px} .dv-lbl{font-size:.6rem;margin-right:1px} .dv-chip{font-size:.66rem;padding:1px 5px;border-radius:4px}
  .chips .chip:nth-child(3),.chips .chip:nth-child(4){display:none}  /* record and last day live on the Summary tab and sub-tab */
  .chips{gap:12px} .chip strong{font-size:1.15rem} .chip small{font-size:.65rem}
  .collapse-btn{display:none}
  .subtabs{display:flex;background:var(--card);border-bottom:1px solid var(--line)}
  .subtabs button{flex:1;border:0;background:none;padding:11px 6px;font-weight:600;color:var(--mute);border-bottom:3px solid transparent}
  .subtabs button[aria-selected="true"]{color:var(--ink);border-bottom-color:var(--accent)}
  #page-daily{flex-direction:column}
  .daily{grid-template-columns:1fr}
  .daily .pane.hide{display:none}
    .wrap{padding:14px 12px 28px}
  .hero{padding:18px 18px 6px}
  .big{font-size:3.4rem}
  .hstats{grid-template-columns:repeat(3,1fr);gap:10px 14px}
  .hstats div strong{font-size:1.2rem}
  .g6{grid-template-columns:1fr 1fr} .g2,.g3,.notes{grid-template-columns:1fr}
  table.t th,table.t td{padding:9px 10px}
  .hide-sm{display:none}
  .bottom-nav{display:flex;flex-shrink:0;background:var(--card);border-top:1px solid var(--line);padding-bottom:env(safe-area-inset-bottom,0px)}
  .bottom-nav button{flex:1;border:0;background:none;padding:10px 4px;font-weight:600;font-size:.8rem;color:var(--faint);display:flex;flex-direction:column;align-items:center;gap:3px}
  .bottom-nav button[aria-selected="true"]{color:var(--ink)}
  .foot{display:none}
}
</style>
</head>
<body>

<header class="topbar">
  <div class="brand"><b>ATGS</b><div class="devig" title="Fair values are devigged to Circa, PN and ESPN"><span class="dv-lbl">Devigged to</span><span class="dv-chip">Circa</span><span class="dv-chip">PN</span><span class="dv-chip">ESPN</span></div><span class="season" id="brandSub"></span></div>
  <div class="chips">
    <div class="chip"><small>Season net</small><strong id="chipNet"></strong></div>
