  $('chipRec').textContent = CUR.n ? CUR.w + '–' + CUR.l : '0–0';
  $('chipLastLbl').textContent = lastDay ? shortDate(lastDay) : 'Last day';
  $('chipLast').textContent = lastDay ? u(lastPL) : '–'; $('chipLast').className = cls(lastPL);
  $('datePill').textContent = longDate(TODAY.date);
  $('segCurrent').textContent = SEASON.label + ' season';

  const items = CUR.n ? [
    `Season net <em>${u(CUR.net)}</em>`, `Record <em>${CUR.w}–${CUR.l}</em>`,
    `Win rate <em>${rate(CUR.w, CUR.w + CUR.l)}</em>`, `ROI <em>${pct(CUR.net, CUR.risked)}</em>`,
    lastDay ? `${shortDate(lastDay)} <em>${u(lastPL)}</em>` : '',
    CUR.top[0] ? `Top player <em>${CUR.top[0].name} ${u(CUR.top[0].pl)}</em>` : '',
  ] : [
    `${SEASON.label} season opens <em>${longDate(SEASON.start)}</em>`,
    `Tracking Circa, ESPN and PN devig against six soft books`,
  ];
  items.push(`2025–26 final <em>${u(ARCHIVE.net)} net</em>`);
  const row = items.filter(Boolean).map(s => `<span>${s}</span>`).join('');
  $('ticker').innerHTML = row + row;
}

/* ── daily panes ── */
function renderToday() {
  const rank = p => p.status === 'cashed' ? 2 : p.status === 'pending' ? 1 : 0;
  const plays = TODAY.plays.map(p => ({ ...p, book: BOOK_ALIAS[p.book] || p.book })).sort((a, b) => rank(a) - rank(b) || (b.ev ?? 0) - (a.ev ?? 0));
  const live = plays.filter(p => !p.status);
  const pendingN = plays.filter(p => p.status === 'pending').length;
  const units = live.reduce((s, p) => s + (p.u ?? 1), 0);
  const evs = live.filter(p => p.ev != null).map(p => p.ev);
  const avgEV = evs.length ? evs.reduce((a, b) => a + b, 0) / evs.length : null;
  const games = new Set(live.map(p => p.game).filter(Boolean)).size;
  const top = live[0];
  $('todayCount').textContent = shortDate(TODAY.date);
  $('subToday').textContent = 'Today' + (live.length ? ' (' + live.length + ')' : '');
  $('slate').innerHTML = `
    <div><small>Plays</small><strong>${live.length}${pendingN ? `<span class="sub">+${pendingN} pending</span>` : games ? `<span class="sub">${games} ${games === 1 ? 'game' : 'games'}</span>` : ''}</strong></div>
    <div><small>Units out</small><strong>${live.length ? units.toFixed(2).replace(/\.00$/, '') + 'u' : '–'}</strong></div>
    <div><small>Avg EV</small><strong class="${avgEV != null ? 'pos' : ''}">${avgEV != null ? avgEV.toFixed(1) + '%' : '–'}</strong></div>
    <div><small>Top EV</small><strong>${top && top.ev != null ? top.ev.toFixed(1) + '%' : '–'}</strong></div>`;
  if (!plays.length) {
    $('todayBody').innerHTML = `<div class="empty"><strong>No plays yet</strong>${TODAY.date === SEASON.start ? 'Opening night. Plays post once lines are devigged.' : 'Plays post once lines are devigged.'}</div>`;
    return;
  }
  const maxEV = Math.max(5, ...live.filter(p => p.ev != null && !p.boost).map(p => p.ev));  // boosts don't stretch the bar scale
  $('todayBody').innerHTML = plays.map((p, i) => {
    const meta = [p.boost ? 'Boosted' : '', p.ev < 0 ? 'Now −EV, can\'t cash out' : '', p.game, p.time].filter(Boolean).join(', ');
    return `<div class="prow${p.status === 'cashed' ? ' cashed' : p.status === 'pending' ? ' pending' : ''}${i === 0 && !p.status ? ' top' : ''}">
      <div><span class="player">${p.player}</span>
        <span class="pmeta">${p.status === 'pending' ? '<span class="ptag">Pending</span>' : ''}${p.status === 'cashed' ? 'Cashed out, ' : ''}<span class="mbook">${dot(p.book)}${p.book}${meta ? ', ' : ''}</span>${meta}${(p.u ?? 1) !== 1 ? ' (' + p.u + 'u)' : ''}</span></div>
      <span class="c-book"><span class="book">${dot(p.book)}${p.book}</span></span>
      <span class="r odds">${odds(p.odds)}</span>
      <span class="r fv c-fv">${odds(p.fv)}</span>
      <span class="evc"><span class="ev${p.ev < 0 ? ' neg' : ''}">${p.ev != null ? sign(p.ev).replace('+', '') + Math.abs(p.ev).toFixed(1) + '%' : '–'}</span><span class="evbar"><i style="width:${p.ev > 0 ? Math.max(4, Math.min(100, p.ev / maxEV * 100)) : 0}%"></i></span></span>
    </div>`; }).join('');
}

function renderYest() {
  $('yestTitle').textContent = lastDay ? 'Results, ' + shortDate(lastDay) : 'Last results';
  $('subYest').textContent = lastDay ? shortDate(lastDay) : 'Results';
  const w = lastBets.filter(b => b.r === 'W').length, l = lastBets.filter(b => b.r === 'L').length;
  $('yestCount').textContent = lastBets.length ? lastBets.length + (lastBets.length === 1 ? ' bet' : ' bets') : '';
  $('yestSum').innerHTML = `
    <div><strong class="pos">${w}</strong><small>Wins</small></div>
    <div><strong class="neg">${l}</strong><small>Losses</small></div>
    <div><strong>${rate(w, w + l)}</strong><small>Win rate</small></div>
    <div><strong class="${cls(lastPL)}">${lastBets.length ? u(lastPL) : '–'}</strong><small>P/L</small></div>`;
  if (!lastBets.length) {
    $('yestList').innerHTML = `<div class="empty"><strong>Nothing settled yet</strong>The first results show here the morning after opening night.</div>`;
    return;
  }
  $('yestList').innerHTML = '<div class="res-grid">' + lastBets.map(b => `
    <div class="res ${b.r}"><i></i>
      <div class="who"><b>${b.p}</b><small>${[dot(b.b) + b.b, b.note, b.ev != null ? 'EV ' + b.ev.toFixed(1) + '%' : '', b.g].filter(Boolean).join(', ')}</small></div>
      <span class="odds o">${odds(b.o)}</span>
      <span class="p ${cls(b.pl)}">${b.r === 'V' ? 'Void' : b.fb && !b.pl ? 'Free bet' : u(b.pl)}</span>
    </div>`).join('') + '</div>';
}

function renderParlays() {
  $('parlayCount').textContent = PARLAYS.length ? PARLAYS.length + (PARLAYS.length === 1 ? ' parlay' : ' parlays') : '';
  $('subParlays').textContent = 'Parlays' + (PARLAYS.length ? ' (' + PARLAYS.length + ')' : '');
  if (!PARLAYS.length) { $('parlayList').innerHTML = `<div class="empty"><strong>No parlays yet</strong>Boosted parlays land here when they qualify.</div>`; return; }
  $('parlayList').innerHTML = PARLAYS.map(p => `
    <div class="parlay">
      <header><span><span class="odds">${odds(p.odds)}</span>${p.boost ? '<span class="tag">Boosted</span>' : ''}</span><small>${[p.book ? dot(p.book) + p.book : '', p.legs.length + '-leg'].filter(Boolean).join(', ')}</small></header>
      ${p.stake ? `<div class="pstake"><span>Stake<b>${p.stake}</b></span><span>To pay<b>${p.payout || ''}</b></span></div>` : ''}
      <div class="legs">${p.legs.map(l => `<div class="leg"><span class="lw"><b>${l.player}</b><small>${[l.prop || 'Anytime goal', l.game, l.time].filter(Boolean).join(', ')}</small></span>${l.odds != null ? `<span class="odds lo">${odds(l.odds)}</span>` : ''}</div>`).join('')}</div>
    </div>`).join('');
}

/* ── season view (shared by current season and archive) ── */
function chartSVG(series, startDate) {
  if (!series.length) return '';
  const pts = [[startDate, 0], ...series];
  const W = 1000, H = 230, pl = 44, pr = 16, pt = 14, pb = 26;
  const t0 = toDate(pts[0][0]).getTime(), t1 = toDate(pts[pts.length - 1][0]).getTime() || t0 + 1;
  const vals = pts.map(p => p[1]), lo = Math.min(0, ...vals), hi = Math.max(1, ...vals);
  const x = d => pl + (toDate(d).getTime() - t0) / Math.max(1, t1 - t0) * (W - pl - pr);
  const y = v => pt + (hi - v) / (hi - lo) * (H - pt - pb);
  const line = pts.map((p, i) => (i ? 'L' : 'M') + x(p[0]).toFixed(1) + ',' + y(p[1]).toFixed(1)).join('');
  const area = line + `L${x(pts[pts.length - 1][0]).toFixed(1)},${y(lo)}L${x(pts[0][0]).toFixed(1)},${y(lo)}Z`;
  const step = hi - lo > 60 ? 25 : hi - lo > 20 ? 10 : 5;
  let grid = '';
  for (let v = Math.ceil(lo / step) * step; v <= hi; v += step)
    grid += `<line x1="${pl}" x2="${W - pr}" y1="${y(v)}" y2="${y(v)}" stroke="rgba(255,255,255,${v === 0 ? .35 : .08})"/>
             <text x="${pl - 8}" y="${y(v) + 4}" text-anchor="end" fill="rgba(255,255,255,.45)" font-size="12" font-family="Barlow Condensed, Arial Narrow, sans-serif">${v}</text>`;
  let months = '', seen = new Set();
  pts.forEach(p => { const k = p[0].slice(0, 7); if (!seen.has(k)) { seen.add(k); const d = toDate(k + '-01'); const xx = Math.max(pl, x(k + '-01'));
    months += `<text x="${xx}" y="${H - 6}" fill="rgba(255,255,255,.45)" font-size="12" font-family="Barlow, system-ui, sans-serif">${MON[d.getMonth()]}</text>`; } });
  const end = pts[pts.length - 1];
  return `<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="Cumulative units by date">
    <defs><linearGradient id="fill${startDate}" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="#5ee08a" stop-opacity=".28"/><stop offset="1" stop-color="#5ee08a" stop-opacity="0"/></linearGradient></defs>
    ${grid}${months}
    <path d="${area}" fill="url(#fill${startDate})"/>
    <path d="${line}" fill="none" stroke="#5ee08a" stroke-width="2.5" stroke-linejoin="round"/>
    <circle cx="${x(end[0])}" cy="${y(end[1])}" r="4.5" fill="#5ee08a"/>
  </svg>`;
}

function renderSeason(el, m, o) {
  const decided = m.w + m.l;
  let h = `
  <div class="hero">
    <div class="hero-top">
      <div>
        <h1>${o.title}</h1><div class="span">${o.span}</div>
        <div class="big ${cls(m.net)}">${u(m.net)}</div><div class="big-lbl">Net units${m.fb ? ' after ' + u(m.fb) + ' in free bets' : ''}</div>
      </div>
      <div class="hstats">
        <div><small>Record</small><strong>${m.n ? rec(m) : '0–0'}</strong></div>
        <div><small>Win rate</small><strong>${rate(m.w, decided)}</strong></div>
        <div><small>ROI, net</small><strong>${pct(m.net, m.risked)}</strong></div>
        <div><small>Bets</small><strong>${m.n}</strong></div>
        <div><small>Gross</small><strong>${u(m.gross)}</strong></div>
        <div><small>ROI, gross</small><strong>${pct(m.gross, m.risked)}</strong></div>
      </div>
    </div>
    <div class="chart-cap">Cumulative units, before free bets</div><div class="chart">${m.series.length ? chartSVG(m.series, o.start) : `<div class="none">The curve starts with the first settled bet.</div>`}</div>
  </div>`;

  if (!m.n) {
    el.innerHTML = h + `<div class="card hint">Books, months, highlights and the player leaderboard fill in automatically as results are added to the log.</div>`;
    return;
  }

  const flat = m.dayCount - m.upDays - m.downDays;
  h += `<h3 class="sec">Daily results</h3><div class="card cal">${calendarSVG(m.series, o.calStart)}
    <div class="cal-foot"><span>${m.upDays} winning days, ${m.downDays} losing${flat ? ', ' + flat + ' flat' : ''}, out of ${m.dayCount}</span>
      <span class="cal-legend"><span>Loss</span>${[...HEAT_L].reverse().map(c => `<i style="background:${c}"></i>`).join('')}<i style="background:#edf1f6"></i>${HEAT_W.map(c => `<i style="background:${c}"></i>`).join('')}<span>Win</span></span></div></div>`;

  const bestMonth = [...m.months].sort((a, b) => b.net - a.net)[0];
  const tiles = [
    ['Best day', u(m.bestDay.pl), shortDate(m.bestDay.d), cls(m.bestDay.pl)],
    ['Worst day', u(m.worstDay.pl), shortDate(m.worstDay.d), cls(m.worstDay.pl)],
    ['Best month', u(bestMonth.net), bestMonth.label, cls(bestMonth.net)],
    ['Longest win streak', m.winStreak + ' straight', 'Consecutive winning bets', ''],
    ['Longest skid', m.lossStreak + ' straight', 'Consecutive losing bets', ''],
    ['Max drawdown', u(m.drawdown.amt), m.drawdown.to ? (m.drawdown.from ? shortDate(m.drawdown.from) : 'Start') + ' to ' + shortDate(m.drawdown.to) : '–', cls(m.drawdown.amt)],
  ];
  h += `<h3 class="sec">Highlights</h3><div class="grid g6">` +
    tiles.map(t => `<div class="card tile"><small>${t[0]}</small><strong class="${t[3]}">${t[1]}</strong><span>${t[2]}</span></div>`).join('') + `</div>`;

  if (o.notes) h += `<h3 class="sec">Takeaways</h3><div class="notes">` +
    o.notes.map(n => `<div class="card note ${n.c}"><b>${n.t}</b><p>${n.p}</p></div>`).join('') + `</div>`;

  const maxAbs = Math.max(...m.books.map(b => Math.abs(b.pl)), 1);
  h += `<h3 class="sec">By book</h3><div class="card"><table class="t">
    <thead><tr><th>Book</th><th>Bets</th><th>Record</th><th class="hide-sm">Win rate</th><th class="hide-sm">ROI</th><th>P/L</th></tr></thead><tbody>` +
    m.books.map(b => `<tr><td>${dot(b.name)}${b.name}</td><td>${b.n}</td><td>${rec(b)}</td><td class="hide-sm">${rate(b.w, b.w + b.l)}</td><td class="hide-sm ${cls(b.pl)}">${pct(b.pl, b.risked)}</td>
      <td class="${cls(b.pl)}"><span class="bar hide-sm" style="width:${Math.round(Math.abs(b.pl) / maxAbs * 70)}px;background:currentColor;opacity:.35"></span>${u(b.pl, '')}</td></tr>`).join('') +
    `</tbody></table></div>`;

  h += `<h3 class="sec">By month</h3><div class="grid g3">` + m.months.map(mo => {
    const books = Object.entries(mo.books).sort((a, b) => b[1] - a[1]);
    return `<div class="card month">
      <header><b>${mo.label}</b><strong class="${cls(mo.net)}">${u(mo.net)}</strong></header>
      <div class="rec">${mo.n} bets, ${rec(mo)}</div>
      ${books.map(([n, v]) => `<div class="row"><span>${dot(n)}${n}</span><span class="${cls(v)}">${u(v, '')}</span></div>`).join('')}
      <footer><span>Gross <b class="${cls(mo.gross)}">${u(mo.gross)}</b></span>${mo.fb ? `<span>Free bets <b class="neg">${u(mo.fb)}</b></span>` : ''}</footer>
    </div>`; }).join('') + `</div>`;

  const lb = (title, list) => `<div class="card lb"><header>${title}</header>` + (list.length ? list.map((p, i) => `
      <div class="row"><span class="rk">${i + 1}</span><b>${p.name}</b><span class="rec">${rec(p)}</span><span class="pl ${cls(p.pl)}">${u(p.pl)}</span></div>`).join('') : `<div class="hint">No players yet.</div>`) + `</div>`;
  h += `<h3 class="sec">Player leaderboard</h3><div class="grid g2">${lb('Top 5', m.top)}${lb('Bottom 5', m.bottom)}</div>`;

  h += `<h3 class="sec">Biggest single wins</h3><div class="card"><table class="t">
    <thead><tr><th>Player</th><th>Book</th><th class="hide-sm">Date</th><th>Odds</th><th>Units</th></tr></thead><tbody>` +
    (m.topWins.some(x => x.pl > 0) ? '' : `<tr><td colspan="5" class="meta">No winners yet.</td></tr>`) + m.topWins.filter(x => x.pl > 0).map(x => `<tr><td>${x.p}</td><td class="meta">${dot(x.b)}${x.b}</td><td class="meta hide-sm">${shortDate(x.d)}</td><td class="odds">${odds(x.o)}</td><td class="pos">${u(x.pl)}</td></tr>`).join('') +
    `</tbody></table></div>`;

  el.innerHTML = h;
}

/* ── navigation ── */
function showPage(page) {
  document.querySelectorAll('.page').forEach(p => p.classList.toggle('on', p.id === 'page-' + page));
  document.querySelectorAll('[data-page]').forEach(b => b.setAttribute('aria-selected', b.dataset.page === page));
}
function showPane(id) {
  document.querySelectorAll('.subtabs [data-pane]').forEach(b => b.setAttribute('aria-selected', b.dataset.pane === id));
  document.querySelectorAll('.daily .pane').forEach(p => p.classList.toggle('hide', p.id !== id));
}
document.querySelectorAll('[data-page]').forEach(b => b.onclick = () => showPage(b.dataset.page));
document.querySelectorAll('[data-pane]').forEach(b => b.onclick = () => showPane(b.dataset.pane));
document.querySelectorAll('[data-view]').forEach(b => b.onclick = () => {
  document.querySelectorAll('[data-view]').forEach(x => x.setAttribute('aria-selected', x === b));
  $('view-current').hidden = b.dataset.view !== 'current';
  $('view-archive').hidden = b.dataset.view !== 'archive';
});
// Panes are only hidden on phones; on wider screens all three show.
const mq = matchMedia('(max-width:640px)');
const syncPanes = () => { if (!mq.matches) document.querySelectorAll('.daily .pane').forEach(p => p.classList.remove('hide'));
  else showPane(document.querySelector('.subtabs [aria-selected="true"]').dataset.pane); };
mq.addEventListener ? mq.addEventListener('change', syncPanes) : mq.addListener(syncPanes);

/* ── init ── */
// Parlays collapse: remembers your choice; starts collapsed on days with no parlays.
function setParlays(collapsed, save) {
  document.querySelector('.daily').classList.toggle('parlays-collapsed', collapsed);
  const b = $('parlayToggle');
  b.setAttribute('aria-expanded', !collapsed);
  b.title = collapsed ? 'Show parlays' : 'Collapse parlays';
  if (save) try { localStorage.setItem('atgs.parlaysCollapsed', collapsed ? '1' : '0'); } catch (e) {}
}
$('parlayToggle').onclick = e => { e.stopPropagation(); setParlays(!document.querySelector('.daily').classList.contains('parlays-collapsed'), true); };
$('parlayHead').onclick = () => { if (!mq.matches && document.querySelector('.daily').classList.contains('parlays-collapsed')) setParlays(false, true); };
let savedParlays = null;
try { savedParlays = localStorage.getItem('atgs.parlaysCollapsed'); } catch (e) {}
setParlays(savedParlays === null ? PARLAYS.length === 0 : savedParlays === '1', false);

renderTop(); renderToday(); renderYest(); renderParlays(); syncPanes();
renderSeason($('view-current'), CUR, { title: 'NHL ' + SEASON.label + ' season', span: (CUR.n ? 'Since ' : 'Opens ') + longDate(SEASON.start), start: SEASON.start, calStart: SEASON.start });
renderSeason($('view-archive'), ARCHIVE, { title: '2025–26 regular season', span: 'Oct 16, 2025 to Apr 13, 2026, 104 betting days', start: '2025-10-15', calStart: '2025-10-16', notes: ARCHIVE_NOTES });
</script>
