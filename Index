const heat = v => { const a = Math.abs(v), i = a < 1.5 ? 0 : a < 3 ? 1 : a < 5 ? 2 : 3; return v > 0 ? HEAT_W[i] : v < 0 ? HEAT_L[i] : '#cfd8e3'; };

// Daily P/L calendar: one square per day, weeks run left to right.
function calendarSVG(series, startStr) {
  const daily = {}; let prev = 0;
  series.forEach(([d, c]) => { daily[d] = Math.round((c - prev) * 100) / 100; prev = c; });
  const start = toDate(startStr), end = toDate(series[series.length - 1][0]);
  const wk0 = new Date(start); wk0.setDate(wk0.getDate() - wk0.getDay());
  const DAY = 864e5, cell = 16, gap = 3, L = 30, T = 20;
  const weeks = Math.floor(Math.round((end - wk0) / DAY) / 7) + 1;
  const W = L + weeks * (cell + gap), H = T + 7 * (cell + gap);
  let s = '', lastMonth = -1, lastLabelX = -99;
  ['Mon','Wed','Fri'].forEach((n, i) => s += `<text x="0" y="${T + (i * 2 + 1) * (cell + gap) + 12}" font-size="11" fill="#8a98ab" font-family="Barlow, system-ui, sans-serif">${n}</text>`);
  for (let d = new Date(start); d <= end; d.setDate(d.getDate() + 1)) {
    const col = Math.floor(Math.round((d - wk0) / DAY) / 7), row = d.getDay();
    const x = L + col * (cell + gap), y = T + row * (cell + gap);
    const key = d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
    if (d.getMonth() !== lastMonth) {
      lastMonth = d.getMonth();
      const lx = row > 3 ? x + cell + gap : x;   // month starting late in a week labels the next column
      if (lx - lastLabelX >= 2 * (cell + gap)) { s += `<text x="${lx}" y="12" font-size="11" fill="#5b6b80" font-family="Barlow, system-ui, sans-serif">${MON[lastMonth]}</text>`; lastLabelX = lx; }
    }
    const v = daily[key];
    s += `<rect x="${x}" y="${y}" width="${cell}" height="${cell}" rx="3" fill="${v === undefined ? '#edf1f6' : heat(v)}"><title>${shortDate(key)}: ${v === undefined ? 'no bets' : u(v)}</title></rect>`;
  }
  return `<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="Daily profit and loss calendar">${s}</svg>`;
}

