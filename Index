// ── ENGINE: turns the bet log into every number on the page ──
const BOOK_ORDER = ['Bet365','FanDuel','MGM','DraftKings','Fanatics','BetRivers','Kalshi','ProphetX','Novig'];
const BOOK_ALIAS = { DK:'DraftKings', FD:'FanDuel', FN:'Fanatics', Kambi:'BetRivers', Robinhood:'BetRivers', 'BetRivers/Kambi':'BetRivers', PX:'ProphetX', NV:'Novig' };
const MONTHS = ['January','February','March','April','May','June','July','August','September','October','November','December'];
const r2 = v => Math.round(v * 100) / 100;

function betPL(x) {
  if (typeof x.pl === 'number') return x.pl;
  const u = x.u ?? 1;
  if (x.r === 'W') return r2(x.o > 0 ? u * x.o / 100 : u * 100 / -x.o);
  if (x.r === 'L') return -u;
  return 0;
}

function buildModel(log, freeBets = []) {
  const bets = log.filter(x => x.r).map(x => ({ ...x, b: BOOK_ALIAS[x.b] || x.b, u: x.u ?? 1, pl: betPL(x) }))
                  .sort((a, b) => a.d < b.d ? -1 : a.d > b.d ? 1 : 0);
  const blank = () => ({ n:0, w:0, l:0, v:0, pl:0, risked:0 });
  const add = (s, x) => { s.n++; s.pl += x.pl; if (x.r === 'V') s.v++; else { if (!x.fb) s.risked += x.u; if (x.r === 'W') s.w++; else if (x.r === 'L') s.l++; } };
  const tot = blank(), books = {}, months = {}, players = {}, days = {};
  bets.forEach(x => {
    add(tot, x);
    add(books[x.b] ||= blank(), x);
    const mk = x.d.slice(0, 7);
    const m = months[mk] ||= { ...blank(), books:{}, fb:0 };
    add(m, x); m.books[x.b] = (m.books[x.b] || 0) + x.pl;
    add(players[x.p] ||= blank(), x);
    days[x.d] = (days[x.d] || 0) + x.pl;
  });
  let fbTotal = 0;
  freeBets.forEach(f => { const mk = f.d.slice(0, 7); (months[mk] ||= { ...blank(), books:{}, fb:0 }).fb += f.u; fbTotal += f.u; });

  // daily series, streaks, drawdown
  const dayList = Object.keys(days).sort().map(d => ({ d, pl: r2(days[d]) }));
  let cum = 0, peak = 0, peakD = null, dd = { amt:0, from:null, to:null };
  const series = dayList.map(x => {
    cum = r2(cum + x.pl);
    if (cum > peak) { peak = cum; peakD = x.d; }
    if (cum - peak < dd.amt) dd = { amt: r2(cum - peak), from: peakD, to: x.d };
    return [x.d, cum];
  });
  let ws = 0, ls = 0, cw = 0, cl = 0;
  bets.filter(x => x.r !== 'V').forEach(x => {
    if (x.pl > 0) { cw++; cl = 0; } else { cl++; cw = 0; }
    ws = Math.max(ws, cw); ls = Math.max(ls, cl);
  });
  const sortedDays = [...dayList].sort((a, b) => b.pl - a.pl);
  const mList = Object.keys(months).sort().map(k => {
    const m = months[k], [y, mo] = k.split('-');
    const bk = {}; Object.entries(m.books).forEach(([n, v]) => bk[n] = r2(v));
    return { key:k, label: MONTHS[+mo - 1] + ' ' + y, n:m.n, w:m.w, l:m.l, v:m.v, risked:r2(m.risked), gross:r2(m.pl), fb:r2(m.fb), net:r2(m.pl + m.fb), books:bk };
  });
  const pList = Object.entries(players).map(([name, s]) => ({ name, n:s.n, w:s.w, l:s.l, v:s.v, pl:r2(s.pl) }));
  const byPL = [...pList].sort((a, b) => b.pl - a.pl || b.n - a.n);
  return {
    n: tot.n, w: tot.w, l: tot.l, v: tot.v, risked: r2(tot.risked),
    gross: r2(tot.pl), fb: r2(fbTotal), net: r2(tot.pl + fbTotal),
    series, dayCount: dayList.length,
    upDays: dayList.filter(x => x.pl > 0).length, downDays: dayList.filter(x => x.pl < 0).length,
    bestDay: sortedDays[0] || null, worstDay: sortedDays[sortedDays.length - 1] || null,
    winStreak: ws, lossStreak: ls, drawdown: dd,
    months: mList,
    books: BOOK_ORDER.concat(Object.keys(books).filter(b => !BOOK_ORDER.includes(b)))
      .filter(b => books[b]).map(b => ({ name:b, n:books[b].n, w:books[b].w, l:books[b].l, v:books[b].v, pl:r2(books[b].pl), risked:r2(books[b].risked) })),
    top: byPL.filter(p => p.pl > 0).slice(0, 5),
    bottom: byPL.filter(p => p.pl < 0).reverse().slice(0, 5),
    topWins: [...bets].sort((a, b) => b.pl - a.pl).slice(0, 5).map(x => ({ p:x.p, b:x.b, d:x.d, o:x.o, pl:r2(x.pl) })),
    last: bets.length ? bets[bets.length - 1].d : null,
    bets,
  };
}


